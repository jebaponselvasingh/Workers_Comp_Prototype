# Copy to deploy/.env (git-ignored). Compose auto-loads .env from the
# project directory, uses it for ${...} interpolation in compose.yaml, and
# (since Story 1.5) passes the whole file into the api container via
# `env_file:` — so every field on `Settings` is settable here, not only the
# ones interpolated below. Before that, keys the compose file did not
# mention were read and silently discarded.
#
# The e2e stack (compose.e2e.yaml) deliberately does *not* read this file:
# its specs assert against the default thresholds, and a local override
# leaking into them would fail the suite with no defect behind it.
POSTGRES_PASSWORD=change-me
# Rotatable at any time: the api reconciles the lineworker_app role with this
# value on every boot, so changing it after the DB volume exists is fine.
# POSTGRES_PASSWORD is not — Postgres only reads it when initializing an empty
# volume, so changing that one needs an ALTER ROLE or `down -v`.
APP_DB_PASSWORD=change-me-too
LOG_LEVEL=INFO

# Session auth (Story 1.3). The cookie carries an opaque session id only —
# role and employer scope are re-resolved from the database per request, so
# shortening the TTL costs a re-login and nothing else.
# SESSION_TTL_HOURS=12
# Secure flag defaults to on when ENV=prod and off otherwise (dev and e2e
# stacks are plain http, where a Secure cookie would never be sent). Set it
# explicitly only when terminating TLS in front of a non-prod stack.
# SESSION_COOKIE_SECURE=true

# Derived-value parameters are NOT env knobs (Story 2.1). The severity band
# the High Risk tile counts moved into the versioned `derivation_thresholds`
# rule document when ZEN landed (AD-8), so RISK_HIGH_MIN and RISK_MED_MIN no
# longer exist as settings — setting them here does nothing. Changing a band
# means seeding a new version of that document in an Alembic migration,
# which is deliberate: the number that decides what counts as a high-risk
# injury should arrive with a reviewed diff and an effective date, not with
# an operator's restart.

# SLA targets (Story 1.5). The strip reports pass/warn against these, and
# the comparison is strict on both sides: a book averaging exactly 1.0d
# pick misses a 1.0 target, and exactly 80% RTW misses an 80 target.
# Both moves are AD-8 parameters — until ZEN JDM owns them, this is where
# they live.
# SLA_PICK_TARGET_DAYS=1
# SLA_APPROVE_TARGET_DAYS=5
# SLA_SETTLE_TARGET_DAYS=30
# SLA_RTW_TARGET_PCT=80
