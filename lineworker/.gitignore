# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/

# Node
node_modules/
web/dist/
*.tsbuildinfo

# Intermediate of `npm run generate:api` — the committed artifact is
# web/src/api/schema.d.ts, regenerated and diffed in CI.
web/openapi.json

# Env files — only *.env.example templates are committed
.env
.env.*
*.env
!*.env.example

# E2E artifacts
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
# Bind-mount target for the e2e backup container (Story 8.3): its status file,
# artifacts and off-host scratch directory, which the Playwright process reads
# from the host. Encrypted claim data, written by a container running as root —
# it must never be committed and must never be assumed to be gone.
e2e/.tmp/

# OS / editor
.DS_Store
*.swp
